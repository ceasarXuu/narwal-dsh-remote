{
  "name": "narwal-dsh-remote",
  "version": "0.6.4",
  "description": "Narwal Server connects the iOS client to DeepSeek Harness over Wi-Fi or an end-to-end encrypted relay.",
  "type": "module",
  "license": "MIT",
  "author": "narwal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceasarXuu/narwal-dsh-remote.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "narwal",
    "remote",
    "ios"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0",
    "node": "^24.22.3 || >=26.13.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "ws": "8.23.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": false
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-deepseek-auth": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-deepseek-auth": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "impl.js",
    "bridge-panel.js",
    "bridge-rpc.js",
    "artifact-downloads.js",
    "attachment-uploads.js",
    "local-web.js",
    "local-web-socket.js",
    "token-store.js",
    "relay-v2.js",
    "relay-pairing-store.js",
    "relay-secure-socket.js",
    "api-balances.js",
    "github-projects.js",
    "github-projects-install.js",
    "maid-install.js",
    "maid-companion.js",
    "notification-content.js",
    "push-notifications.js",
    "live-activities.js",
    "runtime-updates.js",
    "traffic-usage.js",
    "token-usage.js",
    "session-summaries.js",
    "session-control-filter.js",
    "session-transcript.js",
    "workspace-expansion.js",
    "user-questions.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/toqr.mjs",
    "vendor/LICENSE-toqr.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "narwalRuntime": {
    "format": 1,
    "files": [
      "impl.js",
      "bridge-panel.js",
      "bridge-rpc.js",
      "artifact-downloads.js",
      "attachment-uploads.js",
      "local-web.js",
      "local-web-socket.js",
      "api-balances.js",
      "github-projects.js",
      "github-projects-install.js",
      "maid-install.js",
      "maid-companion.js",
      "notification-content.js",
      "push-notifications.js",
      "live-activities.js",
      "token-store.js",
      "relay-v2.js",
      "relay-pairing-store.js",
      "relay-secure-socket.js",
      "traffic-usage.js",
      "token-usage.js",
      "session-summaries.js",
      "session-control-filter.js",
      "session-transcript.js",
      "workspace-expansion.js",
      "user-questions.js",
      "vendor/toqr.mjs"
    ]
  },
  "scripts": {
    "check": "node scripts/check-client.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "private": true
}
